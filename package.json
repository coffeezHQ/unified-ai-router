{
  "name": "unified-ai-router",
  "version": "0.1.0",
  "description": "A unified provider package for the Vercel AI SDK, supporting seamless integration with multiple LLM APIs through a single, pluggable interface.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --runInBand",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "docs": "typedoc src",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coffeezhq/unified-ai-router.git"
  },
  "keywords": [
    "llm",
    "sdk",
    "openai",
    "anthropic",
    "cohere",
    "gemini",
    "ai",
    "typescript",
    "vercel",
    "ai-sdk"
  ],
  "author": "Your Name <your@email.com>",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/provider": "^1.1.3",
    "@ai-sdk/provider-utils": "^2.2.8",
    "axios": "^1.6.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0"
  }
}
